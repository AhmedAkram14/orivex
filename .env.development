NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
OTEL_ENABLED=false
DATABASE_URL=postgresql://orivex:orivex@localhost:5432/orivex
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=orivex
S3_SECRET_ACCESS_KEY=orivex-dev-secret
S3_BUCKET=orivex-media-assets
S3_FORCE_PATH_STYLE=true
JWT_ACCESS_SECRET=development-only-secret-change-in-production-please
JWT_ACCESS_TTL_SECONDS=900
FRONTEND_URL=http://localhost:3000
# I3 -- Notification email delivery: real local transport via the
# already-provisioned Mailpit service (infrastructure/docker/docker-compose.yml).
# Web UI at http://localhost:8025 shows every email sent locally. No secret
# -- Mailpit accepts any SMTP connection unauthenticated, dev-only.
SMTP_HOST=localhost
SMTP_PORT=1025
