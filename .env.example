# Copy to .env.local for personal overrides (git-ignored), or rely on
# .env.development's committed defaults. Every variable here is validated
# at process start by apps/backend/src/core/configuration/env.schema.ts —
# the app fails fast if a required variable is missing or malformed.
#
# Production: copy this file to `.env` (git-ignored, never committed) at the
# repo root, fill in real values, and run
# infrastructure/docker/docker-compose.production.yml with it. In production,
# NODE_ENV=production and every value below should be sourced from a real
# secrets manager at deploy time, not typed into a file on disk.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# The frontend's own canonical origin -- used to build real clickable
# links in outbound email (verify-email/reset-password are both
# link-only pages, no manual code-entry field exists). Optional: unset
# falls back to sending the bare token as plain text.
FRONTEND_URL=http://localhost:3000
# A reversible bypass of LoginUseCase's email-verification gate. Defaults
# to "false" (enforced) when unset -- only ever set to "true" temporarily
# while real email delivery is being set up, never leave it "true"
# anywhere real patient data exists.
SKIP_EMAIL_VERIFICATION=false
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Sentry error reporting (see docs/15-observability.md). Optional -- unset
# means Sentry.init() never runs.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Mounts the generated OpenAPI document (Swagger UI) at GET /docs. Always on
# outside production regardless of this flag; set true to also expose it in
# production (see docs/11-api-contracts.md).
OPENAPI_ENABLED=false

DATABASE_URL=postgresql://orivex:orivex@localhost:5432/orivex
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=orivex
S3_SECRET_ACCESS_KEY=orivex-dev-secret
S3_BUCKET=orivex-media-assets
S3_FORCE_PATH_STYLE=true
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900

# Stripe (ORIVEX Roadmap 2.0 implementation program, Stage 1 -- Payment
# Gateway). Optional -- unset means PaymentModule keeps binding
# NotConfiguredPaymentGatewayAdapter, exactly as it always has.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Only consumed by docker-compose.production.yml, to construct DATABASE_URL
# for the `postgres` service it starts -- not read directly by the backend
# app itself (which only ever reads the assembled DATABASE_URL above).
POSTGRES_DB=orivex
POSTGRES_USER=orivex
POSTGRES_PASSWORD=change-me-in-production
