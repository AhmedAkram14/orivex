# Copy to .env.local for personal overrides (git-ignored), or rely on
# .env.development's committed defaults. Every variable here is validated
# at process start by apps/backend/src/core/configuration/env.schema.ts —
# the app fails fast if a required variable is missing or malformed.
#
# Production: copy this file to `.env` (git-ignored, never committed) at the
# repo root, fill in real values, and run
# infrastructure/docker/docker-compose.production.yml with it. In production,
# NODE_ENV=production and every value below should be sourced from a real
# secrets manager at deploy time, not typed into a file on disk.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
OTEL_ENABLED=false
DATABASE_URL=postgresql://orivex:orivex@localhost:5432/orivex
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=orivex
S3_SECRET_ACCESS_KEY=orivex-dev-secret
S3_BUCKET=orivex-media-assets
S3_FORCE_PATH_STYLE=true
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900

# Only consumed by docker-compose.production.yml, to construct DATABASE_URL
# for the `postgres` service it starts -- not read directly by the backend
# app itself (which only ever reads the assembled DATABASE_URL above).
POSTGRES_DB=orivex
POSTGRES_USER=orivex
POSTGRES_PASSWORD=change-me-in-production
