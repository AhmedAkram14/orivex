# Copy to .env.local for local development (git-ignored). In Vercel,
# set this in the project's Environment Variables settings instead --
# never commit a real value.
#
# NEXT_PUBLIC_ prefix is required: Next.js only inlines env vars with this
# prefix into client-side bundles, and this URL is called from client
# components too, not just the server (see src/shared/lib/env.ts).

# Local backend (docker-compose / pnpm dev), matching apps/backend's
# default PORT (see apps/backend/.env.example):
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Production (Render): the deployed backend's real URL, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://orivex-backend.onrender.com

# This app's own canonical origin, used for absolute URLs in SEO metadata
# (canonical links, hreflang alternates, Open Graph). Optional locally --
# falls back to Vercel's own preview/production URL when unset there.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opt-in MSW request mocking (see src/mocks/). Defaults to false -- never
# enable this in a real environment by accident.
# NEXT_PUBLIC_ENABLE_API_MOCKS=false

# Sentry error reporting (sentry.client/server/edge.config.ts). Optional --
# with this unset, Sentry.init() never runs and error capture is a no-op.
# See docs/15-observability.md.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Only needed if uploading source maps to Sentry at build time (next.config.ts's
# withSentryConfig) -- omit entirely for local dev.
# SENTRY_ORG=orivex
# SENTRY_PROJECT=orivex-frontend
# SENTRY_AUTH_TOKEN=

# Stripe Elements' publishable key (ORIVEX Roadmap 2.0 implementation
# program, Stage 1 -- Payment Gateway). Optional -- with this unset,
# PayNowForm renders an honest "payments are not available yet" state
# instead of a broken card field.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
