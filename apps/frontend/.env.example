# Copy to .env.local for local development (git-ignored). In Vercel,
# set this in the project's Environment Variables settings instead --
# never commit a real value.
#
# NEXT_PUBLIC_ prefix is required: Next.js only inlines env vars with this
# prefix into client-side bundles, and this URL is called from client
# components too, not just the server (see src/lib/env.ts).

# Local backend (docker-compose / pnpm dev), matching apps/backend's
# default PORT (see apps/backend/.env.example):
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Production (Render): the deployed backend's real URL, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://orivex-backend.onrender.com
