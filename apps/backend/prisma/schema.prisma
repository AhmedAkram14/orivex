generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String    @id @default(uuid())
  keycloakId        String    @unique
  email             String    @unique
  role              String    @default("patient")
  // Added Sprint 1.1C, synchronizing the persistence model with the already
  // approved Identity domain (Sprints 1.1A/1.1B) — docs/08-logical-data-model.md
  // and docs/09-physical-database.md don't yet reflect these fields; a
  // documentation synchronization task is scheduled after this sprint.
  status            String    @default("active")
  displayName       String
  phoneNumber       String?
  preferredLanguage String    @default("Arabic")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]
  doctorProfile     DoctorProfile?
  patientProfile    PatientProfile?
}

// Local mirror of a Keycloak-issued session, for audit/session-validation lookups only.
// Credential verification and token issuance remain Keycloak's responsibility (docs/10-backend-architecture.md, Section 10).
model Session {
  id                 String    @id @default(uuid())
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  keycloakSessionId  String    @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
}

// Sprint 2: DoctorModule's aggregate root (docs/10-backend-architecture.md's
// DoctorModule entry). Verification status (TrustModule, future sprint) is
// deliberately not duplicated here - single source of truth per fact.
model DoctorProfile {
  id                     String                @id @default(uuid())
  accountId              String                @unique
  account                Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  licenseNumber          String
  specialty              String
  biography              String?
  yearsOfExperience      Int?
  languages              String[]
  consultationFeeAmount  Decimal?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  publications           PortfolioPublication[]
  awards                 PortfolioAward[]
  verificationCases      VerificationCase[]
  availabilityWindows    AvailabilityWindow[]
  appointments           Appointment[]
  paymentTransactions    PaymentTransaction[]
  authoredHealthGraphNodes HealthGraphNode[]
  authoredClinicalNotes  ClinicalNote[]
}

model PortfolioPublication {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  title           String
  reference       String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
}

model PortfolioAward {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  title           String
  issuingBody     String?
  awardedAt       DateTime?
  createdAt       DateTime      @default(now())
}

// Sprint 3: AssetModule's aggregate root (docs/10-backend-architecture.md's
// AssetModule entry). Binary content lives in external S3-compatible object
// storage — this table holds pointers/metadata only (docs/09-physical-
// database.md's assets schema description).
model MediaAsset {
  id                     String                 @id @default(uuid())
  purpose                String
  contentType            String
  sizeEstimate           Int?
  storageKey             String                 @unique
  status                 String                 @default("pending")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  verificationDocuments  VerificationDocument[]
}

enum VerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_NEEDED
  RE_VERIFICATION_DUE
  SUSPENDED
}

// Sprint 4: TrustModule's aggregate root (docs/10-backend-architecture.md's
// TrustModule entry). Documents are modeled as an explicit relation to
// existing MediaAsset rows (docs/11-api-contracts.md's "reference by ID via
// AssetModule" pattern), never as a raw ID array.
model VerificationCase {
  id            String                 @id @default(uuid())
  doctorId      String
  doctorProfile DoctorProfile          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  licenseNumber String
  specialtyCode String
  status        VerificationStatus     @default(SUBMITTED)
  reason        String?
  submittedAt   DateTime               @default(now())
  decidedAt     DateTime?
  documents     VerificationDocument[]

  @@index([doctorId])
  @@index([status])
  @@index([submittedAt])
}

model VerificationDocument {
  id                 String           @id @default(uuid())
  verificationCaseId String
  verificationCase   VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  mediaAssetId       String
  mediaAsset         MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@unique([verificationCaseId, mediaAssetId])
}

enum EmergencyRelationship {
  PARENT
  SPOUSE
  SIBLING
  CHILD
  GUARDIAN
  OTHER
}

// Sprint 6 (reduced scope): PatientModule's aggregate root
// (docs/10-backend-architecture.md's PatientModule entry: "Owned entities:
// PatientProfile, EmergencyContact, GuardianLink"). GuardianLink is
// deliberately excluded -- docs/09-physical-database.md doesn't detail its
// columns and the age-of-majority/guardian-consent business rules aren't
// specified anywhere concretely. No additional demographic fields beyond
// what's already documented (accountId, dateOfBirth).
model PatientProfile {
  id                String             @id @default(uuid())
  accountId         String             @unique
  account           Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  dateOfBirth       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  emergencyContacts EmergencyContact[]
  appointments      Appointment[]
  paymentTransactions PaymentTransaction[]
  healthGraph       HealthGraph?
}

model EmergencyContact {
  id               String                @id @default(uuid())
  patientProfileId String
  patientProfile   PatientProfile        @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  name             String
  relationship     EmergencyRelationship
  phoneNumber      String
  createdAt        DateTime              @default(now())
}

enum AvailabilityWindowStatus {
  OPEN
  HELD
  BOOKED
}

enum ConsultationType {
  FREE
  PAID
}

// Sprint 7 (revised roadmap): DoctorModule's own aggregate root
// (docs/10-backend-architecture.md's DoctorModule entry: "Owned entities:
// ... AvailabilityWindow"; docs/09-physical-database.md's
// doctor.availability_windows table). SchedulingModule owns no persistence
// of its own -- it orchestrates by calling DoctorModule's exported
// state-transition use cases. version supports optimistic locking ahead of
// SchedulingModule's concurrent slot-reservation use case. Deliberately
// independent of Appointment -- Booking integrates later (Sprint 9).
model AvailabilityWindow {
  id               String                   @id @default(uuid())
  doctorId         String
  doctorProfile    DoctorProfile            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  startTime        DateTime
  endTime          DateTime
  consultationType ConsultationType
  status           AvailabilityWindowStatus @default(OPEN)
  holdExpiresAt    DateTime?
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  appointments     Appointment[]

  @@index([doctorId, startTime])
  @@index([status])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum ConsultationState {
  WAITING_ROOM
  IN_PROGRESS
  COMPLETED
  INTERRUPTED
  CLOSED
  EMERGENCY_ESCALATION
}

enum ConsultationCompletionReason {
  COMPLETED
  INTERRUPTED_TECHNICAL
  INTERRUPTED_OTHER
}

// Sprint 8: ConsultationModule's two aggregate roots
// (docs/10-backend-architecture.md's ConsultationModule entry: "Owned
// entities: Appointment, ConsultationSession, SessionConnectionLog").
// linkedJourneyId is deliberately not stored -- Health Journey doesn't
// exist yet; a real FK relation will be added when it does, not an opaque
// ID field. rescheduledFrom is a real self-referential relation, not an
// opaque ID, preserving referential integrity. version supports optimistic
// locking for both aggregates ahead of concurrent booking/session workflows.
model Appointment {
  id                    String              @id @default(uuid())
  patientId             String
  patientProfile        PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId              String
  doctorProfile         DoctorProfile       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  availabilityWindowId  String
  availabilityWindow    AvailabilityWindow  @relation(fields: [availabilityWindowId], references: [id], onDelete: Restrict)
  consultationType      ConsultationType
  status                AppointmentStatus   @default(REQUESTED)
  scheduledAt           DateTime
  reasonForVisit        String?
  rescheduledFromId     String?
  rescheduledFrom        Appointment?        @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo          Appointment[]       @relation("AppointmentReschedule")
  version               Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  consultationSession   ConsultationSession?

  @@index([patientId])
  @@index([doctorId])
  @@index([availabilityWindowId])
  @@index([scheduledAt])
  @@index([status])
}

model ConsultationSession {
  id                String                        @id @default(uuid())
  appointmentId     String                        @unique
  appointment       Appointment                   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  state             ConsultationState             @default(WAITING_ROOM)
  completionReason  ConsultationCompletionReason?
  version           Int                           @default(1)
  startedAt         DateTime?
  closedAt          DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  connectionLogs    SessionConnectionLog[]
  paymentTransactions PaymentTransaction[]
  healthGraphNodes  HealthGraphNode[]
  clinicalNotes     ClinicalNote[]

  @@index([state])
}

model SessionConnectionLog {
  id                    String              @id @default(uuid())
  consultationSessionId String
  consultationSession   ConsultationSession @relation(fields: [consultationSessionId], references: [id], onDelete: Cascade)
  note                  String
  occurredAt            DateTime            @default(now())

  @@index([consultationSessionId])
  @@index([occurredAt])
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  SETTLED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  CARD
  MOBILE_WALLET
}

// Sprint 9: PaymentModule's aggregate root (docs/10-backend-architecture.md's
// PaymentModule entry: "Owned entities: PaymentTransaction, PayoutStatement").
// PayoutStatement is out of this sprint's scope (not in
// IMPLEMENTATION_PLAN.md's bullet list). consultationSessionId is nullable,
// matching docs/09-physical-database.md's payment_transactions table
// exactly. RESTRICT on every FK -- financial data, never cascade-deleted.
model PaymentTransaction {
  id                    String               @id @default(uuid())
  consultationSessionId String?
  consultationSession   ConsultationSession?  @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  patientId             String
  patientProfile        PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId              String
  doctorProfile         DoctorProfile        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  amount                Decimal
  currency              String
  paymentMethod         PaymentMethod
  status                PaymentStatus        @default(INITIATED)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationSessionId])
  @@index([status])
}

enum HealthGraphNodeType {
  CONDITION
  SYMPTOM
  MEDICATION
  LAB_RESULT
  RADIOLOGY_RESULT
}

enum CertaintyLevel {
  SUSPECTED
  CONFIRMED
  RULED_OUT
}

enum NodeSource {
  CLINICAL
  PATIENT_REPORTED
  DEVICE
}

enum JourneyStage {
  DIAGNOSIS
  FOLLOW_UP
  MONITORING
  RESOLVED
  ONGOING_CHRONIC
  REFERRED_OUT
}

// Sprint 10: ClinicalModule's aggregate cluster (docs/10-backend-
// architecture.md's ClinicalModule entry -- "sole owner of clinical
// truth"). HealthGraph is the per-patient container aggregate root;
// HealthGraphNode is its child (docs/07-domain-data-model.md's Health
// Graph Aggregate: "Root: the patient's Health Graph... Child entities:
// individual nodes"). Lazily created ("Created at first encounter" per
// docs/09-physical-database.md). HealthGraphEdge is deliberately not
// modeled this sprint -- no documented endpoint or response schema
// exercises it (GET /patients/{id}/health-graph returns HealthGraphNode[]
// only); introduce it in the sprint that actually needs it, with full
// domain behavior, not speculatively now.
model HealthGraph {
  id            String            @id @default(uuid())
  patientId     String            @unique
  patientProfile PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  nodes         HealthGraphNode[]
  journeys      HealthJourney[]
}

// icd11_code_id is deliberately omitted -- it would reference
// reference.icd11_codes (ReferenceDataModule), which doesn't exist yet;
// no opaque placeholder FK is introduced in its place.
model HealthGraphNode {
  id                    String              @id @default(uuid())
  healthGraphId         String
  healthGraph           HealthGraph         @relation(fields: [healthGraphId], references: [id], onDelete: Restrict)
  nodeType              HealthGraphNodeType
  freeTextDescription   String?
  certaintyLevel        CertaintyLevel      @default(SUSPECTED)
  source                NodeSource          @default(CLINICAL)
  authoringDoctorId     String?
  doctorProfile         DoctorProfile?      @relation(fields: [authoringDoctorId], references: [id], onDelete: Restrict)
  consultationSessionId String?
  consultationSession   ConsultationSession? @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  supersedesNodeId      String?
  supersedes            HealthGraphNode?    @relation("NodeSupersede", fields: [supersedesNodeId], references: [id], onDelete: Restrict)
  supersededBy          HealthGraphNode[]   @relation("NodeSupersede")
  createdAt             DateTime            @default(now())
  journeysAsRoot        HealthJourney[]     @relation("JourneyRootNode")
  journeyLinks          JourneyNodeLink[]

  @@index([healthGraphId])
  @@index([nodeType])
}

// Aggregate root (docs/07-domain-data-model.md's Health Journey Aggregate:
// "Root: the Journey itself"). linkedNodeIds (docs/12-openapi.md's
// HealthJourney schema) is backed by the journey_node_links junction table
// (docs/09-physical-database.md), a simple many-to-many -- not the more
// general HealthGraphEdge concept.
model HealthJourney {
  id            String            @id @default(uuid())
  healthGraphId String
  healthGraph   HealthGraph       @relation(fields: [healthGraphId], references: [id], onDelete: Restrict)
  rootNodeId    String
  rootNode      HealthGraphNode   @relation("JourneyRootNode", fields: [rootNodeId], references: [id], onDelete: Restrict)
  stage         JourneyStage      @default(DIAGNOSIS)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  linkedNodes   JourneyNodeLink[]

  @@index([healthGraphId])
  @@index([stage])
}

model JourneyNodeLink {
  id        String          @id @default(uuid())
  journeyId String
  journey   HealthJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  nodeId    String
  node      HealthGraphNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@unique([journeyId, nodeId])
}

// Aggregate root, own PK separate from HealthGraphNode (docs/09-physical-
// database.md's clinical_notes table). Immutable once created -- addenda
// are new rows referencing the original via addendumOfNoteId, never a
// mutation (docs/07-domain-data-model.md's "never rewrite" rule).
// derivedFromSuggestionId is deliberately not stored -- would reference
// AISuggestion (AIModule), which doesn't exist yet.
model ClinicalNote {
  id                    String        @id @default(uuid())
  consultationSessionId String
  consultationSession   ConsultationSession @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  authoringDoctorId     String
  doctorProfile         DoctorProfile @relation(fields: [authoringDoctorId], references: [id], onDelete: Restrict)
  content               String
  addendumOfNoteId      String?
  addendumOf            ClinicalNote? @relation("NoteAddendum", fields: [addendumOfNoteId], references: [id], onDelete: Restrict)
  addenda               ClinicalNote[] @relation("NoteAddendum")
  createdAt             DateTime      @default(now())

  @@index([consultationSessionId])
}
