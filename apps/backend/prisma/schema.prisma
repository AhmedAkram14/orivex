generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String             @id @default(uuid())
  email             String             @unique
  role              String             @default("patient")
  // Added Sprint 1.1C, synchronizing the persistence model with the already
  // approved Identity domain (Sprints 1.1A/1.1B) — docs/08-logical-data-model.md
  // and docs/09-physical-database.md don't yet reflect these fields; a
  // documentation synchronization task is scheduled after this sprint.
  status            String             @default("active")
  displayName       String
  phoneNumber       String?
  preferredLanguage String             @default("Arabic")
  // Onboarding Redesign (2026-07-21 proposal, §0a): cross-role personal
  // identity fields, extending the existing UserProfile child entity rather
  // than introducing a separate PersonalProfile table -- Identity remains the
  // single owner of "who this person is," shared verbatim by both Patient and
  // Doctor onboarding. Deliberately NOT a fullName field: displayName already
  // serves that purpose.
  dateOfBirth       DateTime?
  // Plain string, not a Prisma enum type -- matches role/status/
  // preferredLanguage's own existing convention above (domain-layer enum,
  // string-typed column; see identity/domain/enums/gender.enum.ts).
  gender            String?
  nationalityId     String?
  nationality       Country?           @relation(fields: [nationalityId], references: [id], onDelete: SetNull)
  address           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  credential        Credential?
  doctorProfile     DoctorProfile?
  patientProfile    PatientProfile?
  securityEvents    SecurityEvent[]
  notifications     Notification[]
  mediaAssets       MediaAsset[]
  // Onboarding Redesign (2026-07-21 proposal, Stage O.2): VerificationCase
  // references the subject's Account directly and uniformly, regardless of
  // subject type -- not DoctorProfile.id as it did before.
  verificationCases VerificationCase[]
}

enum CredentialStatus {
  ACTIVE
  LOCKED
}

// AuthenticationModule's own aggregate root for credential verification —
// deliberately separate from Account (Identity keeps owning Account/Profile/
// Roles; Authentication owns how a person proves they are that Account).
// One Credential per Account (docs/14-adrs.md: first-party auth, no Keycloak).
model Credential {
  id                  String           @id @default(uuid())
  accountId           String           @unique
  account             Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passwordHash        String
  status              CredentialStatus @default(ACTIVE)
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  emailVerifiedAt     DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sessions            Session[]
  tokens              AuthToken[]
}

// One row = one logical login session AND its current refresh-token
// credential (rotated in place on every /auth/refresh call, never a growing
// history table). Replaces the earlier Keycloak-shaped Session model.
model Session {
  id               String     @id @default(uuid())
  credentialId     String
  credential       Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  refreshTokenHash String     @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime   @default(now())
  createdAt        DateTime   @default(now())

  @@index([credentialId])
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TokenStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

// Single-use, expiring, hashed-at-rest tokens for both email verification
// and password reset — one table, disambiguated by purpose, rather than two
// near-identical tables.
model AuthToken {
  id           String       @id @default(uuid())
  credentialId String
  credential   Credential   @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  tokenHash    String       @unique
  purpose      TokenPurpose
  status       TokenStatus  @default(ACTIVE)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())

  @@index([credentialId, purpose])
}

// Sprint 2: DoctorModule's aggregate root (docs/10-backend-architecture.md's
// DoctorModule entry). Verification status (TrustModule, future sprint) is
// deliberately not duplicated here - single source of truth per fact.
model DoctorProfile {
  id                              String                   @id @default(uuid())
  accountId                       String                   @unique
  account                         Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  licenseNumber                   String
  biography                       String?
  yearsOfExperience               Int?
  languages                       String[]
  consultationFeeAmount           Decimal?
  // ORIVEX Roadmap 2.0 Stage 4: optional grouping/org-chart link only, not
  // multi-tenant scoping (true tenant isolation is explicitly deferred, see
  // Stage 4's roadmap completion note) -- a doctor may exist with no
  // hospital affiliation at all.
  hospitalId                      String?
  hospital                        Hospital?                @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  // Onboarding Redesign (2026-07-21 proposal, Stage O.9): the sole source of
  // a doctor's specialty, now that the transitional free-text `specialty`
  // column (removed this stage, after a verified backfill -- see this
  // stage's own migration) is gone. Restrict, not SetNull: a MedicalSpecialty
  // referenced by a real doctor can no longer be deleted out from under a
  // required field. departmentId requires hospitalId (enforced in the
  // domain entity, not the database) -- a doctor may exist with neither,
  // with only a hospital, or with both a hospital and a department, but
  // never a department alone.
  specialtyId                     String
  medicalSpecialty                MedicalSpecialty         @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  professionalRank                String?
  licenseExpiryDate               DateTime?
  departmentId                    String?
  department                      Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt
  publications                    PortfolioPublication[]
  awards                          PortfolioAward[]
  // VerificationCase no longer relates to DoctorProfile directly (Onboarding
  // Redesign, 2026-07-21 proposal, Stage O.2) -- it references Account via
  // subjectAccountId uniformly for every subject type. A repository join
  // through DoctorProfile.accountId is how "cases for this doctor profile"
  // queries are served when needed, not a stored relation here.
  availabilityWindows             AvailabilityWindow[]
  appointments                    Appointment[]
  paymentTransactions             PaymentTransaction[]
  authoredHealthGraphNodes        HealthGraphNode[]
  authoredClinicalNotes           ClinicalNote[]
  authoredPrescriptions           Prescription[]
  workingHoursDays                WorkingHoursDay[]
  scheduleExceptions              ScheduleException[]
  // Consultation lifecycle completion follow-up (2026-07-26): reviews are
  // the sole source of a doctor's rating -- computed at read time by
  // aggregating these rows (AVG/COUNT), never a stored/manually-editable
  // rating column on this model.
  receivedFeedback                ConsultationFeedback[]
  authoredFollowUpRecommendations FollowUpRecommendation[]

  @@index([hospitalId])
  @@index([specialtyId])
  @@index([departmentId])
}

// ORIVEX Roadmap 2.0 Stage 4: AdministrationModule's own aggregate root -- a
// plain grouping/org-chart entity, not a multi-tenant boundary (no other
// table is tenant-scoped by hospitalId; true SaaS-grade tenant isolation is
// explicitly deferred, see Stage 4's roadmap completion note). Deleting a
// Hospital cascades to its Departments but only detaches (SetNull) any
// DoctorProfile pointed at it -- a doctor's own record must never be
// destroyed as a side effect of an org-chart edit.
model Hospital {
  id          String          @id @default(uuid())
  name        String
  address     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  departments Department[]
  doctors     DoctorProfile[]
}

model Department {
  id         String          @id @default(uuid())
  hospitalId String
  hospital   Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime        @default(now())
  // Onboarding Redesign (2026-07-21 proposal, Stage O.3): first real
  // consumer of Department -- previously an orphaned org-chart node with no
  // relation back to DoctorProfile at all.
  doctors    DoctorProfile[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

// Onboarding Redesign (2026-07-21 proposal, §4/§6): finishes the `reference`
// schema docs/09-physical-database.md already designed but never built.
// Plain, runtime-extensible lookup data (SuperAdmin-managed) -- not owned by
// any single bounded context, referenced by Doctor (specialty) and Patient
// (insurance provider, nationality) alike.
// doctorProfiles back-relation intentionally not added yet -- DoctorProfile
// gains its specialtyId FK in Stage O.3, not this stage (§10/§14 sequencing:
// reference tables ship standalone first, with zero coupling to Doctor/
// Patient profiles, before anything references them).
model MedicalSpecialty {
  id             String          @id @default(uuid())
  name           String          @unique
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // Onboarding Redesign (2026-07-21 proposal, Stage O.3): first real
  // consumer -- Stage O.1 deliberately shipped this table with zero
  // coupling to DoctorProfile first.
  doctorProfiles DoctorProfile[]
}

model Country {
  id                    String    @id @default(uuid())
  name                  String    @unique
  iso2Code              String    @unique
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // Doubles as the nationality list -- a nationality is a country reference,
  // no separate table (proposal §4).
  accountsByNationality Account[]
}

// patientProfiles back-relation intentionally not added yet -- same
// sequencing reason as MedicalSpecialty above; PatientProfile gains its
// insuranceProviderId FK in Stage O.3.
model InsuranceProvider {
  id              String           @id @default(uuid())
  name            String           @unique
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // Onboarding Redesign (2026-07-21 proposal, Stage O.3): first real
  // consumer -- Stage O.1 deliberately shipped this table with zero
  // coupling to PatientProfile first.
  patientProfiles PatientProfile[]
}

model PortfolioPublication {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  title           String
  reference       String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([doctorProfileId])
}

model PortfolioAward {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  title           String
  issuingBody     String?
  awardedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([doctorProfileId])
}

// Sprint 3: AssetModule's aggregate root (docs/10-backend-architecture.md's
// AssetModule entry). Binary content lives in external S3-compatible object
// storage — this table holds pointers/metadata only (docs/09-physical-
// database.md's assets schema description).
model MediaAsset {
  id                    String                 @id @default(uuid())
  purpose               String
  contentType           String
  sizeEstimate          Int?
  storageKey            String                 @unique
  status                String                 @default("pending")
  // The account that requested this upload intent -- required so
  // confirm-upload can enforce that only the owner may confirm/download
  // their own asset (closes an IDOR: presigned download URLs must never be
  // mintable by an arbitrary authenticated caller guessing another user's
  // asset id).
  ownerAccountId        String
  owner                 Account                @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  verificationDocuments VerificationDocument[]

  @@index([ownerAccountId])
}

enum VerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_NEEDED
  RE_VERIFICATION_DUE
  SUSPENDED
}

// Sprint 4: TrustModule's aggregate root (docs/10-backend-architecture.md's
// TrustModule entry). Documents are modeled as an explicit relation to
// existing MediaAsset rows (docs/11-api-contracts.md's "reference by ID via
// AssetModule" pattern), never as a raw ID array.
// Onboarding Redesign (2026-07-21 proposal, Stage O.2): generalized from
// Doctor-only to any verification subject. subjectAccountId is the uniform
// reference every subject type shares; licenseNumber/specialtyCode are
// nullable and populated only for subjectType=DOCTOR (mirrors the domain
// entity's own DoctorProfessionalDetails value object -- no doctorId column
// or DoctorProfile relation anymore, see DoctorProfile's own comment on why).
model VerificationCase {
  id               String                  @id @default(uuid())
  subjectAccountId String
  subjectAccount   Account                 @relation(fields: [subjectAccountId], references: [id], onDelete: Restrict)
  subjectType      VerificationSubjectType
  licenseNumber    String?
  specialtyCode    String?
  status           VerificationStatus      @default(SUBMITTED)
  reason           String?
  submittedAt      DateTime                @default(now())
  decidedAt        DateTime?
  documents        VerificationDocument[]

  @@index([subjectAccountId])
  @@index([subjectType])
  @@index([status])
  @@index([submittedAt])
}

enum VerificationSubjectType {
  DOCTOR
  PATIENT
}

model VerificationDocument {
  id                 String           @id @default(uuid())
  verificationCaseId String
  verificationCase   VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  mediaAssetId       String
  mediaAsset         MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@unique([verificationCaseId, mediaAssetId])
  @@index([mediaAssetId])
}

enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  SESSION_REVOKED
  REFRESH_TOKEN_REUSE_DETECTED
}

enum SecurityEventStatus {
  DETECTED
  REVIEWED
  RESOLVED
}

// Sprint 15: TrustModule's SecurityEvent aggregate (docs/10-backend-
// architecture.md's TrustModule entry: "Owned entities: ..., SecurityEvent").
// Populated by AuthenticationModule (the actual producer of every event this
// table describes) through TrustModule's exported RecordSecurityEventUseCase
// — a legitimate module-to-module use-case call, never a direct write to
// this table from outside TrustModule. Append-only audit trail.
model SecurityEvent {
  id         String              @id @default(uuid())
  accountId  String
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventType  SecurityEventType
  status     SecurityEventStatus @default(DETECTED)
  ipAddress  String?
  userAgent  String?
  metadata   Json                @default("{}")
  detectedAt DateTime            @default(now())
  reviewedAt DateTime?
  resolvedAt DateTime?

  @@index([accountId])
  @@index([eventType])
  @@index([status])
}

enum EmergencyRelationship {
  PARENT
  SPOUSE
  SIBLING
  CHILD
  GUARDIAN
  OTHER
}

// Sprint 6 (reduced scope): PatientModule's aggregate root
// (docs/10-backend-architecture.md's PatientModule entry: "Owned entities:
// PatientProfile, EmergencyContact, GuardianLink"). GuardianLink is
// deliberately excluded -- docs/09-physical-database.md doesn't detail its
// columns and the age-of-majority/guardian-consent business rules aren't
// specified anywhere concretely. No additional demographic fields beyond
// what's already documented (accountId, dateOfBirth).
model PatientProfile {
  id                  String                 @id @default(uuid())
  accountId           String                 @unique
  account             Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  // dateOfBirth moved to Account/UserProfile (Onboarding Redesign,
  // 2026-07-21 proposal §0a) -- Identity owns cross-role personal info.
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  emergencyContacts   EmergencyContact[]
  appointments        Appointment[]
  paymentTransactions PaymentTransaction[]
  healthGraph         HealthGraph?
  vitalReadings       VitalReading[]
  // Onboarding Redesign (2026-07-21 proposal, Stage O.3): Patient's own
  // medical-profile fields -- deliberately unstructured free text for
  // allergies/chronicDiseases (no ICD-11/SNOMED CT, no reference tables,
  // for this phase; normalizing into discrete, coded entries is a future
  // phase, per the approved proposal).
  bloodType           String?
  allergies           String?
  chronicDiseases     String?
  insuranceProviderId String?
  insuranceProvider   InsuranceProvider?     @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  // Consultation lifecycle completion follow-up (2026-07-26).
  submittedFeedback   ConsultationFeedback[]

  @@index([insuranceProviderId])
}

model EmergencyContact {
  id               String                @id @default(uuid())
  patientProfileId String
  patientProfile   PatientProfile        @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  name             String
  relationship     EmergencyRelationship
  phoneNumber      String
  createdAt        DateTime              @default(now())

  @@index([patientProfileId])
}

enum AvailabilityWindowStatus {
  OPEN
  HELD
  BOOKED
}

enum ConsultationType {
  FREE
  PAID
}

// Sprint 7 (revised roadmap): DoctorModule's own aggregate root
// (docs/10-backend-architecture.md's DoctorModule entry: "Owned entities:
// ... AvailabilityWindow"; docs/09-physical-database.md's
// doctor.availability_windows table). SchedulingModule owns no persistence
// of its own -- it orchestrates by calling DoctorModule's exported
// state-transition use cases. version supports optimistic locking ahead of
// SchedulingModule's concurrent slot-reservation use case. Deliberately
// independent of Appointment -- Booking integrates later (Sprint 9).
model AvailabilityWindow {
  id               String                   @id @default(uuid())
  doctorId         String
  doctorProfile    DoctorProfile            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  startTime        DateTime
  endTime          DateTime
  consultationType ConsultationType
  status           AvailabilityWindowStatus @default(OPEN)
  holdExpiresAt    DateTime?
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  appointments     Appointment[]

  @@index([doctorId, startTime])
  @@index([status])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum ConsultationState {
  WAITING_ROOM
  IN_PROGRESS
  COMPLETED
  INTERRUPTED
  CLOSED
  EMERGENCY_ESCALATION
}

enum ConsultationCompletionReason {
  COMPLETED
  INTERRUPTED_TECHNICAL
  INTERRUPTED_OTHER
}

// Sprint 8: ConsultationModule's two aggregate roots
// (docs/10-backend-architecture.md's ConsultationModule entry: "Owned
// entities: Appointment, ConsultationSession, SessionConnectionLog").
// linkedJourneyId is deliberately not stored -- Health Journey doesn't
// exist yet; a real FK relation will be added when it does, not an opaque
// ID field. rescheduledFrom is a real self-referential relation, not an
// opaque ID, preserving referential integrity. version supports optimistic
// locking for both aggregates ahead of concurrent booking/session workflows.
model Appointment {
  id                   String               @id @default(uuid())
  patientId            String
  patientProfile       PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId             String
  doctorProfile        DoctorProfile        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  availabilityWindowId String
  availabilityWindow   AvailabilityWindow   @relation(fields: [availabilityWindowId], references: [id], onDelete: Restrict)
  consultationType     ConsultationType
  status               AppointmentStatus    @default(REQUESTED)
  scheduledAt          DateTime
  reasonForVisit       String?
  rescheduledFromId    String?
  rescheduledFrom      Appointment?         @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo        Appointment[]        @relation("AppointmentReschedule")
  version              Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  consultationSession  ConsultationSession?

  @@index([patientId])
  @@index([doctorId])
  @@index([availabilityWindowId])
  @@index([scheduledAt])
  @@index([status])
  // Backs the doctor dashboard/upcoming-work/queue endpoints' "today's
  // appointments for this doctor" query pattern (see
  // ListAppointmentsForDoctorUseCase's now-date-scoped repository call).
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
}

model ConsultationSession {
  id                                 String                              @id @default(uuid())
  appointmentId                      String                              @unique
  appointment                        Appointment                         @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  state                              ConsultationState                   @default(WAITING_ROOM)
  completionReason                   ConsultationCompletionReason?
  version                            Int                                 @default(1)
  startedAt                          DateTime?
  closedAt                           DateTime?
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  connectionLogs                     SessionConnectionLog[]
  paymentTransactions                PaymentTransaction[]
  healthGraphNodes                   HealthGraphNode[]
  clinicalNotes                      ClinicalNote[]
  prescriptions                      Prescription[]
  aiSuggestions                      AISuggestion[]
  pendingAISuggestionAcknowledgments PendingAISuggestionAcknowledgment[]
  // Consultation lifecycle completion follow-up (2026-07-26): one feedback
  // row and one follow-up recommendation per session, at most -- both
  // deliberately 1:1 (unique FK), not lists.
  consultationFeedback               ConsultationFeedback?
  followUpRecommendation             FollowUpRecommendation?

  @@index([state])
}

// Consultation lifecycle completion follow-up (2026-07-26): the sole source
// of a doctor's rating -- DoctorProfile deliberately carries no editable
// rating column (§10 of the fix's own scope). One review per completed
// consultation (consultationSessionId is unique, not just indexed) --
// enforced at the database level, not just application-side, since this is
// a real business invariant ("one review per consultation") rather than a
// performance-only index. patientId/doctorId are both stored redundantly
// (derivable from the session's own appointment) purely to make the two
// most common queries -- "this doctor's reviews" and "this patient's
// submitted reviews" -- simple indexed lookups instead of a join through
// ConsultationSession -> Appointment every time; they are set once at
// submission from the session's own appointment, never client-supplied.
model ConsultationFeedback {
  id                    String              @id @default(uuid())
  consultationSessionId String              @unique
  consultationSession   ConsultationSession @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  patientId             String
  patientProfile        PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId              String
  doctorProfile         DoctorProfile       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  rating                Int
  comment               String?
  createdAt             DateTime            @default(now())

  @@index([doctorId])
  @@index([patientId])
}

// Consultation lifecycle completion follow-up (2026-07-26): the smallest
// real capability that lets a doctor's follow-up recommendation survive
// consultation completion and reach the patient -- deliberately NOT a
// second booking system (§13 of the fix's own scope): the patient books the
// actual follow-up appointment through the existing real booking flow
// (GET /doctors -> POST /appointments), this just carries the doctor's own
// recommendation (a suggested date + reason) so the patient sees it.
model FollowUpRecommendation {
  id                    String              @id @default(uuid())
  consultationSessionId String              @unique
  consultationSession   ConsultationSession @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  authoringDoctorId     String
  doctorProfile         DoctorProfile       @relation(fields: [authoringDoctorId], references: [id], onDelete: Restrict)
  recommendedDate       DateTime?
  reason                String
  createdAt             DateTime            @default(now())

  @@index([authoringDoctorId])
}

model SessionConnectionLog {
  id                    String              @id @default(uuid())
  consultationSessionId String
  consultationSession   ConsultationSession @relation(fields: [consultationSessionId], references: [id], onDelete: Cascade)
  note                  String
  occurredAt            DateTime            @default(now())

  @@index([consultationSessionId])
  @@index([occurredAt])
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  SETTLED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  CARD
  MOBILE_WALLET
}

// Sprint 9: PaymentModule's aggregate root (docs/10-backend-architecture.md's
// PaymentModule entry: "Owned entities: PaymentTransaction, PayoutStatement").
// PayoutStatement is out of this sprint's scope (not in
// IMPLEMENTATION_PLAN.md's bullet list). consultationSessionId is nullable,
// matching docs/09-physical-database.md's payment_transactions table
// exactly. RESTRICT on every FK -- financial data, never cascade-deleted.
model PaymentTransaction {
  id                    String               @id @default(uuid())
  // Production Readiness Audit: client-supplied, globally-unique key that
  // makes initiateCharge safely retryable -- a network-timeout retry of the
  // same request replays the original outcome instead of double-charging.
  idempotencyKey        String               @unique
  consultationSessionId String?
  consultationSession   ConsultationSession? @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  patientId             String
  patientProfile        PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId              String
  doctorProfile         DoctorProfile        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  amount                Decimal
  currency              String
  paymentMethod         PaymentMethod
  status                PaymentStatus        @default(INITIATED)
  // Stripe PaymentIntent id (or equivalent for a future gateway) -- lets an
  // inbound webhook event or a doctor/admin-initiated refund be matched
  // back to this exact transaction. Null until the gateway confirms the
  // charge attempt (ORIVEX Roadmap 2.0 Stage 1 -- Stripe integration).
  externalReference     String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationSessionId])
  @@index([status])
}

enum HealthGraphNodeType {
  CONDITION
  SYMPTOM
  MEDICATION
  LAB_RESULT
  RADIOLOGY_RESULT
}

enum CertaintyLevel {
  SUSPECTED
  CONFIRMED
  RULED_OUT
}

enum NodeSource {
  CLINICAL
  PATIENT_REPORTED
  DEVICE
}

enum JourneyStage {
  DIAGNOSIS
  FOLLOW_UP
  MONITORING
  RESOLVED
  ONGOING_CHRONIC
  REFERRED_OUT
}

// Sprint 10: ClinicalModule's aggregate cluster (docs/10-backend-
// architecture.md's ClinicalModule entry -- "sole owner of clinical
// truth"). HealthGraph is the per-patient container aggregate root;
// HealthGraphNode is its child (docs/07-domain-data-model.md's Health
// Graph Aggregate: "Root: the patient's Health Graph... Child entities:
// individual nodes"). Lazily created ("Created at first encounter" per
// docs/09-physical-database.md). HealthGraphEdge is deliberately not
// modeled this sprint -- no documented endpoint or response schema
// exercises it (GET /patients/{id}/health-graph returns HealthGraphNode[]
// only); introduce it in the sprint that actually needs it, with full
// domain behavior, not speculatively now.
model HealthGraph {
  id             String            @id @default(uuid())
  patientId      String            @unique
  patientProfile PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())
  nodes          HealthGraphNode[]
  journeys       HealthJourney[]
}

// icd11_code_id is deliberately omitted -- it would reference
// reference.icd11_codes (ReferenceDataModule), which doesn't exist yet;
// no opaque placeholder FK is introduced in its place.
model HealthGraphNode {
  id                    String               @id @default(uuid())
  healthGraphId         String
  healthGraph           HealthGraph          @relation(fields: [healthGraphId], references: [id], onDelete: Restrict)
  nodeType              HealthGraphNodeType
  freeTextDescription   String?
  certaintyLevel        CertaintyLevel       @default(SUSPECTED)
  source                NodeSource           @default(CLINICAL)
  authoringDoctorId     String?
  doctorProfile         DoctorProfile?       @relation(fields: [authoringDoctorId], references: [id], onDelete: Restrict)
  consultationSessionId String?
  consultationSession   ConsultationSession? @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  supersedesNodeId      String?
  supersedes            HealthGraphNode?     @relation("NodeSupersede", fields: [supersedesNodeId], references: [id], onDelete: Restrict)
  supersededBy          HealthGraphNode[]    @relation("NodeSupersede")
  createdAt             DateTime             @default(now())
  journeysAsRoot        HealthJourney[]      @relation("JourneyRootNode")
  journeyLinks          JourneyNodeLink[]
  prescriptions         Prescription[]

  @@index([healthGraphId])
  @@index([nodeType])
  @@index([authoringDoctorId])
  @@index([consultationSessionId])
  @@index([supersedesNodeId])
}

// Aggregate root (docs/07-domain-data-model.md's Health Journey Aggregate:
// "Root: the Journey itself"). linkedNodeIds (docs/12-openapi.md's
// HealthJourney schema) is backed by the journey_node_links junction table
// (docs/09-physical-database.md), a simple many-to-many -- not the more
// general HealthGraphEdge concept.
model HealthJourney {
  id            String            @id @default(uuid())
  healthGraphId String
  healthGraph   HealthGraph       @relation(fields: [healthGraphId], references: [id], onDelete: Restrict)
  rootNodeId    String
  rootNode      HealthGraphNode   @relation("JourneyRootNode", fields: [rootNodeId], references: [id], onDelete: Restrict)
  stage         JourneyStage      @default(DIAGNOSIS)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  linkedNodes   JourneyNodeLink[]

  @@index([healthGraphId])
  @@index([stage])
  @@index([rootNodeId])
}

model JourneyNodeLink {
  id        String          @id @default(uuid())
  journeyId String
  journey   HealthJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  nodeId    String
  node      HealthGraphNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@unique([journeyId, nodeId])
}

// Aggregate root, own PK separate from HealthGraphNode (docs/09-physical-
// database.md's clinical_notes table). Immutable once created -- addenda
// are new rows referencing the original via addendumOfNoteId, never a
// mutation (docs/07-domain-data-model.md's "never rewrite" rule).
// derivedFromSuggestionId is deliberately not stored -- would reference
// AISuggestion (AIModule), which doesn't exist yet.
model ClinicalNote {
  id                    String              @id @default(uuid())
  consultationSessionId String
  consultationSession   ConsultationSession @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  authoringDoctorId     String
  doctorProfile         DoctorProfile       @relation(fields: [authoringDoctorId], references: [id], onDelete: Restrict)
  content               String
  addendumOfNoteId      String?
  addendumOf            ClinicalNote?       @relation("NoteAddendum", fields: [addendumOfNoteId], references: [id], onDelete: Restrict)
  addenda               ClinicalNote[]      @relation("NoteAddendum")
  createdAt             DateTime            @default(now())

  @@index([consultationSessionId])
  @@index([authoringDoctorId])
  @@index([addendumOfNoteId])
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  ACTIVE
  EXPIRED
  SUPERSEDED
}

// Sprint 11: ClinicalModule's aggregate root for signed medication orders
// (docs/10-backend-architecture.md's ClinicalModule entry;
// docs/09-physical-database.md's prescriptions table). diagnosisNodeId is a
// real FK to HealthGraphNode -- the actual point of the Sprint 10/11
// roadmap reordering. supersedesPrescriptionId is deliberately not modeled
// -- no documented endpoint or use case creates a superseding prescription
// this sprint; introduce it together with its full domain behavior when a
// real workflow needs it.
model Prescription {
  id                    String                 @id @default(uuid())
  consultationSessionId String
  consultationSession   ConsultationSession    @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  diagnosisNodeId       String
  diagnosisNode         HealthGraphNode        @relation(fields: [diagnosisNodeId], references: [id], onDelete: Restrict)
  authoringDoctorId     String
  doctorProfile         DoctorProfile          @relation(fields: [authoringDoctorId], references: [id], onDelete: Restrict)
  status                PrescriptionStatus     @default(DRAFT)
  signedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  lineItems             PrescriptionLineItem[]

  @@index([consultationSessionId])
  @@index([diagnosisNodeId])
  @@index([authoringDoctorId])
  @@index([status])
}

// Child entity, immutable once the parent Prescription is signed
// (docs/09-physical-database.md). drugCatalogId is deliberately stored as
// a plain field with no FK -- it would reference reference.drug_catalog
// (ReferenceDataModule), which doesn't exist yet. This is real,
// doctor-supplied data (required by docs/12-openapi.md's
// PrescriptionLineItem), not an opaque placeholder -- only the referential-
// integrity check against a real catalog is deferred.
model PrescriptionLineItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drugCatalogId  String
  drugName       String?
  dosage         String
  frequency      String
  durationDays   Int
  instructions   String?

  @@index([prescriptionId])
}

enum AISuggestionType {
  SOAP_DRAFT
  PRESCRIPTION_DRAFT
  INTERACTION_FLAG
  SUGGESTED_QUESTION
  SUMMARY
  FOLLOW_UP_PLAN
}

enum AISuggestionDecision {
  APPROVED
  EDITED
  REJECTED
}

// Sprint 12: AIModule's own aggregate (docs/10-backend-architecture.md's
// AIModule entry; docs/09-physical-database.md's ai_suggestions table).
// promptVersionId is deliberately omitted -- it would reference a
// ReferenceDataModule PromptVersion table, which doesn't exist yet (same
// omission pattern as drugCatalogId in Sprint 11). doctorDecision is
// settable exactly once -- enforced at the application layer (ConflictError,
// matching docs/12-openapi.md's documented 409 on a second decision call),
// not by a DB trigger, consistent with this codebase's existing app-layer
// enforcement of physical-db-documented invariants (no live Postgres in
// this sandbox to author triggers against).
model AISuggestion {
  id                     String                @id @default(uuid())
  consultationSessionId  String
  consultationSession    ConsultationSession   @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  suggestionType         AISuggestionType
  content                String
  confidenceScore        Float?
  safetyFlags            Json                  @default("[]")
  requiresAcknowledgment Boolean               @default(false)
  doctorDecision         AISuggestionDecision?
  decisionJustification  String?
  generatedAt            DateTime              @default(now())
  decidedAt              DateTime?

  @@index([consultationSessionId])
}

// ClinicalModule's own read-model (docs/10-backend-architecture.md's hard
// rule: "ClinicalModule ... Never depends on AIModule ... Clinical must
// never block on or require AI availability"). Populated exclusively by
// Clinical's own event subscriber reacting to AIModule's published
// AISuggestionGenerated/AISuggestionDecided events -- never by a
// synchronous query into AIModule. suggestionId intentionally reuses
// AISuggestion's own id (Clinical was told this id via the event payload,
// not generating a new identity for someone else's aggregate).
// SignPrescriptionUseCase's "blocked with 422 if an unacknowledged
// Warning-tier AI suggestion exists" check (docs/12-openapi.md) queries
// this table only.
model PendingAISuggestionAcknowledgment {
  suggestionId          String              @id
  consultationSessionId String
  consultationSession   ConsultationSession @relation(fields: [consultationSessionId], references: [id], onDelete: Restrict)
  acknowledgedAt        DateTime?
  createdAt             DateTime            @default(now())

  @@index([consultationSessionId])
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  DANGER
}

// NotificationModule's own aggregate root -- docs/05-information-
// architecture.md: "Notifications Domain: Owns delivery only... a pure
// consumer/router... never originates meaning." docs/09-physical-database.md:
// notifications is a genuine-hard-delete table (no soft-delete column) with
// a short retention window and a CASCADE from Account ("low-stakes,
// disposable data"). This sprint builds the delivery/query/mark-read surface
// only -- no producer wiring across other modules yet (that's the documented
// "consumes nearly every event in the system" future work); this table is
// honestly empty until that lands.
model Notification {
  id          String               @id @default(uuid())
  accountId   String
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title       String
  description String
  severity    NotificationSeverity @default(INFO)
  read        Boolean              @default(false)
  createdAt   DateTime             @default(now())
  /// Same-origin, locale-agnostic app path (e.g. "/admin/verification-queue/{id}")
  /// the frontend navigates to when this notification is clicked -- null for
  /// notifications with no single relevant page to jump to.
  actionUrl   String?

  @@index([accountId])
  @@index([createdAt])
}

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ScheduleExceptionType {
  VACATION
  UNAVAILABLE
  EXTRA_HOURS
}

// SchedulingModule's own aggregate: a doctor's recurring weekly working-hours
// template -- always exactly 7 rows per doctor (one per WeekDay), enforced
// by UpdateDoctorWorkingHoursUseCase's full replace-all-7 upsert, not by a
// database constraint. `breaks` is Json (TimeRange[]) since it's a
// variable-length list, not a fixed set of columns. CASCADE from
// DoctorProfile: this data has no meaning without the doctor it belongs to.
model WorkingHoursDay {
  id            String        @id @default(uuid())
  doctorId      String
  doctorProfile DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek     WeekDay
  isWorkingDay  Boolean       @default(false)
  startTime     String
  endTime       String
  breaks        Json          @default("[]")
  updatedAt     DateTime      @updatedAt

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
}

// One doctor's own one-off override (vacation/unavailable/extra-hours) of
// their recurring weekly schedule for a specific date. startTime/endTime
// only apply to EXTRA_HOURS exceptions (nullable for the other two types).
model ScheduleException {
  id            String                @id @default(uuid())
  doctorId      String
  doctorProfile DoctorProfile         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date          DateTime
  type          ScheduleExceptionType
  startTime     String?
  endTime       String?
  reason        String?
  createdAt     DateTime              @default(now())

  @@index([doctorId])
}

// A global, doctor-agnostic non-working date (docs/05-information-
// architecture.md; distinct from ScheduleException, which is one doctor's
// own vacation/unavailable date). Read-only in this phase -- no create use
// case exists yet, same "real read, deferred write" pattern this session
// already used for Notification; a future Admin feature will populate this
// table.
model Holiday {
  id   String   @id @default(uuid())
  date DateTime @unique
  name String
}

enum VitalType {
  WEIGHT
  BLOOD_PRESSURE
  BLOOD_SUGAR
}

// The Patient Portal Health Dashboard's own vitals surface (docs/05-
// information-architecture.md's Health Dashboard concept). There is no
// vitals concept anywhere else in the platform yet -- HealthGraphNode's
// nodeType enum only covers condition/symptom/medication/lab_result/
// radiology_result, and no create/record-vital producer exists on either
// side yet, so this table starts empty. Read-only in this phase, same
// "real read, deferred write" pattern already used for Notification/
// Holiday.
model VitalReading {
  id             String         @id @default(uuid())
  patientId      String
  patientProfile PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           VitalType
  value          Float
  diastolicValue Float?
  recordedAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@index([patientId])
  @@index([type])
}
