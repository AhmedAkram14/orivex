{
  "name": "orivex-platform",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "backend:prisma:generate": "pnpm --filter @orivex/backend prisma:generate",
    "backend:prisma:migrate": "pnpm --filter @orivex/backend prisma:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1"
  }
}
